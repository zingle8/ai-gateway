<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.zimo.gateway</groupId>
    <artifactId>api-gateway</artifactId>
  <version>1.0.0</version>
  </parent>

  <artifactId>jv-gateway-client-starter</artifactId>
  <name>jv-gateway-client-starter</name>
  <description>网关接入子模块（Spring Boot Starter）：自动接入注册、请求与响应采集并上报到网关平台</description>

  <dependencies>
    <dependency>
      <groupId>com.zimo.gateway</groupId>
      <artifactId>jv-gateway-client-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>jv-gateway-client-starter</finalName>
  </build>
</project>

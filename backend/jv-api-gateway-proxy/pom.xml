<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.zimo.gateway</groupId>
    <artifactId>api-gateway</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>jv-api-gateway-proxy</artifactId>
  <name>jv-api-gateway-proxy</name>
  <description>流量代理：按 tb_gw_route 转发请求，并记录完整调用详情</description>

  <dependencies>
    <!-- 响应式网关。注意：不能依赖 jv-api-gateway-common（它带 spring-boot-starter-web，
         会让应用启动成 Servlet 应用，Gateway 直接失效） -->
    <!-- Nacos 配置中心客户端（v0.2 配置集中）：仅用于拉取 gw-platform-infra.properties，
         不做服务注册（proxy 自持运行）。optional 保证 Nacos 不可达时按本地 yml 兜底启动 -->
    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-gateway</artifactId>
    </dependency>

    <!-- 统一持久层：原生 MyBatis（只依赖 spring-jdbc，不引入 Servlet 栈，WebFlux 安全） -->
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
    </dependency>
    <!-- DataSource / HikariCP 仍由 starter-jdbc 提供 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- JWT 验签：与 user 服务共享密钥；不依赖 common（会带 Servlet 栈），自带精简实现 -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>0.12.5</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>0.12.5</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>0.12.5</version>
      <scope>runtime</scope>
    </dependency>

    <!-- 进程内缓存：API Key / 用户令牌版本 30s，热路径不回源查库 -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <!-- Redis：鉴权元数据缓存（Redis 优先，不可用时自动回落本地 Caffeine） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-pool2</artifactId>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- 与其余模块保持一致：产出 target/jv-api-gateway-proxy.jar，供 scripts 启停脚本使用 -->
    <finalName>jv-api-gateway-proxy</finalName>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
      </resource>
      <!-- SQL 统一放 backend/sql，按模块前缀打包进 jar 的 db/ 目录 -->
      <resource>
        <directory>${project.basedir}/../sql</directory>
        <includes>
          <include>jv-api-gateway-proxy-*.sql</include>
        </includes>
        <targetPath>db</targetPath>
      </resource>
    </resources>
    <!-- 与其余模块保持一致：产出 target/jv-api-gateway-proxy.jar，供 scripts 启停脚本使用 -->
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

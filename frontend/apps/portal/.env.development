# 本地开发环境
VITE_APP_TITLE=AI 网关平台

# 统一 API 前缀；dev 下由 vite proxy 按业务前缀转发到对应微服务：
#   /api/auth、/api/users   -> jv-gateway-user      :28081
#   /api/overview           -> jv-gateway-overview  :28082
#   /api/discovery          -> jv-gateway-discovery :28083
#   /api/trace              -> jv-gateway-trace     :28084
VITE_API_BASE=/api

{
  "name": "@zimo/gateway-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI 网关平台前端工程（npm workspaces 单体仓库，按业务模块微服务化拆分）",
  "workspaces": [
    "packages/*",
    "modules/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @zimo/portal",
    "build": "npm run build --workspace @zimo/portal",
    "preview": "npm run preview --workspace @zimo/portal"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "element-plus": "^2.8.8",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^5.4.11"
  }
}
